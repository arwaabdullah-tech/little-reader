# Copy to .env and fill in. Never commit .env.

# OpenAI (story writer, safety check, cartoon photo, cover, read-aloud voice, speech-to-text)
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_FALLBACK_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# 0 = the real website for families (accounts, real data only, bedtime lock).
# 1 = presenting: one-click guest start, the mic fills in Sara's ready answers, no bedtime lock,
#     sample history on the parents' page, and a backup story if the AI fails.
DEMO_MODE=1

# Login tokens. Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_random_64_character_secret

DATABASE_URL=sqlite:////data/little_reader.db
MEDIA_DIR=/data/media
CORS_ORIGINS=http://localhost:8080
# Asia/Riyadh = +3; the app sleeps after the story until WAKE_HOUR local time
TZ_OFFSET_HOURS=3
WAKE_HOUR=7
